{
  "name": "gateway-node",
  "version": "0.1.0",
  "private": true,
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node --test --test-timeout=300000 \"test/integration/*.test.js\"",
    "test:all": "npm test && npm run test:integration"
  },
  "dependencies": {
    "express": "^5.3.0",
    "ioredis": "^5.4.1",
    "pg": "^8.11.3",
    "pino": "^9.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  }
}
