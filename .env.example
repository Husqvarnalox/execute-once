# Copied by `make env`. Values here are for local development only.

# Gateway
PORT=3000
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=app
PGPASSWORD=app
PGDATABASE=app
PGPOOL_MAX=20
REDIS_URL=redis://127.0.0.1:6379
IDEM_TTL_SECONDS=3600
LOG_LEVEL=info
BODY_LIMIT=16kb

# Relay / consumer (Spring Boot)
DB_URL=jdbc:postgresql://127.0.0.1:5432/app
DB_USER=app
DB_PASSWORD=app
KAFKA_BOOTSTRAP=127.0.0.1:9092

# Bench
TARGET_URL=http://127.0.0.1:3000/api/events
DB_URL_BENCH=postgresql://app:app@127.0.0.1:5432/app
